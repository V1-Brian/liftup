{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/health",     "destination": "/api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/monthly-sync",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/email/poll",
      "schedule": "0 */4 * * *"
    }
  ]
}
